@startuml

top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 42
skinparam defaultFontSize 13
skinparam ArrowFontSize 11
hide stereotype

title Архітектура системи бронювання навчальних аудиторій (UC-02)

actor "Студент / Викладач" as User

rectangle "Система бронювання аудиторій\n(межа системи)" as System {
  component "Web UI" as UI
  component "Booking API" as API
  component "BookingService" as BookingSvc
  component "AvailabilityService" as AvailSvc
  component "AuthenticationAdapter" as AuthAdapter
  component "BookingRepository\n(Data Access)" as BookingRepo
  component "RoomRepository\n(Data Access)" as RoomRepo
  database "Booking Database\nUser, Room, Booking,\nBookingStatus, Equipment, RoomEquipment" as DB

  ' Контракти на стрілках: зліва — required; справа — provided.
  UI -down-> API : IBookingApi
  API -down-> BookingSvc : IBookingService
  BookingSvc -down-> AvailSvc : IAvailabilityService
  BookingSvc -down-> AuthAdapter : IAuthentication
  BookingSvc -down-> BookingRepo : IBookingRepository
  AvailSvc -down-> RoomRepo : IRoomRepository

  AvailSvc ..> BookingRepo : IBookingRepository\n(блокуючі Booking)
  BookingSvc ..> RoomRepo : IRoomRepository

  BookingRepo -down-> DB : SQL / транзакції
  RoomRepo -down-> DB : SQL / запити
}

cloud "Університетський сервіс\nавтентифікації\n(зовнішня система)" as ExtAuth
User -down-> UI : пошук / бронювання
AuthAdapter -right-> ExtAuth : validateSession(session)\nvalid(userId) / invalid / timeout

note right of BookingSvc
  UC-02: створення бронювання.
  Повторна перевірка доступності
  перед записом (REQ-02A).
  Початковий статус: Pending.
end note

legend bottom
  Назва на стрілці — контракт між компонентами.
  Джерело стрілки потребує інтерфейс (required).
  Ціль стрілки надає інтерфейс (provided).
  Зовнішня автентифікація — поза межею системи.
endlegend
@enduml
