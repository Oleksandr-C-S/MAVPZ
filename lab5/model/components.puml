@startuml

top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 42
skinparam defaultFontSize 13
skinparam ArrowFontSize 11
hide stereotype

title Архітектура системи бронювання навчальних аудиторій (UC-02)

actor "Студент / Викладач" as User

rectangle "Система бронювання аудиторій\n(межа системи)" as System {
  component "Web UI" as UI
  component "Booking API" as API
  component "BookingService" as BookingSvc
  component "AvailabilityService" as AvailSvc
  component "AuthenticationAdapter" as AuthAdapter
  component "BookingRepository\n(Data Access)" as BookingRepo
  component "RoomRepository\n(Data Access)" as RoomRepo
  database "Booking Database\nUser, Building, Room, Booking,\nBookingStatus, Equipment, RoomEquipment" as DB

  ' Явні UML-інтерфейси: реалізація (provided) та використання (required).
  interface "IBookingApi" as IBookingApi
  interface "IBookingService" as IBookingService
  interface "IAvailabilityService" as IAvailabilityService
  interface "IAuthentication" as IAuthentication
  interface "IBookingRepository" as IBookingRepository
  interface "IRoomRepository" as IRoomRepository

  ' Реалізація інтерфейсу компонентом (provided).
  API ..|> IBookingApi
  BookingSvc ..|> IBookingService
  AvailSvc ..|> IAvailabilityService
  AuthAdapter ..|> IAuthentication
  BookingRepo ..|> IBookingRepository
  RoomRepo ..|> IRoomRepository

  ' Залежність компонента від контракту (required).
  UI ..> IBookingApi : required
  API ..> IBookingService : required
  BookingSvc ..> IAvailabilityService : required
  BookingSvc ..> IAuthentication : required
  BookingSvc ..> IBookingRepository : required
  ' Атомарне створення: BookingService викликає контракт репозиторію.
  AvailSvc ..> IBookingRepository : required (блокуючі Booking)
  AvailSvc ..> IRoomRepository : required
  BookingSvc ..> IRoomRepository : required

  BookingRepo -down-> DB : транзакція + повторна перевірка
  ' Перевірка blockingBookings і INSERT виконуються в одній транзакції.
  RoomRepo -down-> DB : SQL / запити
}

cloud "Університетський сервіс\nавтентифікації\n(зовнішня система)" as ExtAuth
User -down-> UI : пошук / бронювання
AuthAdapter -right-> ExtAuth : validateSession(session)\nvalid(userId) / invalid / timeout

note right of BookingSvc
  UC-02: створення бронювання.
  Координує UC-02:
  викликає createBookingAtomically(
    userId, roomId, start, end, Pending).
  Початковий статус: Pending.
end note

note right of BookingRepo
  Власник атомарної операції (REQ-02A):
  beginTransaction(), lockRoom(roomId),
  checkBlockingBookings(roomId, start, end),
  insertBooking(..., Pending) / rollback,
  commitTransaction().
  Уся послідовність — одна транзакція.
end note

legend bottom
  Пунктирна стрілка ..> до інтерфейсу: required.
  Реалізація ..|> інтерфейсу: provided.
  Зовнішня автентифікація — поза межею системи.
endlegend
@enduml
