@startuml

top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 32
skinparam ranksep 46
skinparam defaultFontSize 13
skinparam ArrowFontSize 11
hide stereotype

title Компоненти системи бронювання аудиторій (UC-02)

actor "Студент / викладач" as User

rectangle "Система бронювання аудиторій" {
  package "1. Інтерфейс та API" {
    component "Web UI" as UI
    interface "IBookingApi" as IApi
    component "Booking API" as API
  }

  package "2. Бізнес-логіка та інтеграція" {
    interface "IBookingService" as IBooking
    component "BookingService" as BookingSvc
    interface "IAvailabilityService" as IAvail
    component "AvailabilityService" as AvailSvc
    interface "IAuthentication" as IAuth
    component "AuthenticationAdapter" as AuthAdapter
  }

  package "3. Доступ до даних" {
    interface "IBookingRepository" as IBookingRepo
    component "BookingRepository" as BookingRepo
    interface "IRoomRepository" as IRoomRepo
    component "RoomRepository" as RoomRepo
    database "Booking Database\nUser, Building, Room, Booking,\nBookingStatus, Equipment, RoomEquipment" as DB
  }

  ' required: компонент залежить від контракту
  UI ..> IApi
  API ..> IBooking
  BookingSvc ..> IAvail
  BookingSvc ..> IAuth
  BookingSvc ..> IBookingRepo
  BookingSvc ..> IRoomRepo
  AvailSvc ..> IBookingRepo
  AvailSvc ..> IRoomRepo

  ' provided: компонент реалізує контракт
  API ..|> IApi
  BookingSvc ..|> IBooking
  AvailSvc ..|> IAvail
  AuthAdapter ..|> IAuth
  BookingRepo ..|> IBookingRepo
  RoomRepo ..|> IRoomRepo

  ' Тільки репозиторії звертаються безпосередньо до БД
  BookingRepo --> DB
  RoomRepo --> DB
}

cloud "Університетський сервіс\nавтентифікації\n(зовнішній)" as ExtAuth
User --> UI
AuthAdapter --> ExtAuth : validateSession(session)

note right of BookingRepo
  REQ-02A / Lab3:
  BookingService -> BookingRepository:
  beginAtomicBooking(roomId, start, end)
  Repo -> DB: beginTransactionAndLockRoom(roomId)
  Repo -> DB: findBlockingBookings(...)
  Repo -> BookingService: availabilityResult
  BookingService вирішує наступний виклик:
  якщо вільно -> Repo.insertBooking(..., Pending)
  Repo -> DB: INSERT і commitTransaction()
  інакше -> Repo.rollbackTransaction()
  Усе в межах однієї транзакції.
end note

note right of AuthAdapter
  validateSession(session)
  valid(userId) / invalid / timeout
  Lab3 показує прямий логічний виклик
  BookingService -> Auth;
  тут зовнішню інтеграцію винесено
  в AuthenticationAdapter (Lab4).
end note

legend bottom
  ..> required: споживає інтерфейс
  ..|> provided: реалізує інтерфейс
endlegend
@enduml
