@startuml

top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 65
skinparam defaultFontSize 15
skinparam ArrowFontSize 12
hide stereotype

title Архітектура бронювання навчальних аудиторій — UC-02

actor "Студент / Викладач" as User

rectangle "Система бронювання аудиторій" as System {
  ' Рівень інтерфейсу
  component "Web UI" as UI
  interface "IBookingApi" as IBookingApi
  component "Booking API" as API
  interface "IBookingService" as IBookingService
  component "BookingService" as BookingSvc

  ' Сервіси і адаптери
  interface "IAvailabilityService" as IAvailabilityService
  component "AvailabilityService" as AvailSvc
  interface "IAuthentication" as IAuthentication
  component "AuthenticationAdapter" as AuthAdapter

  ' Рівень даних
  interface "IBookingRepository" as IBookingRepository
  component "BookingRepository" as BookingRepo
  interface "IRoomRepository" as IRoomRepository
  component "RoomRepository" as RoomRepo
  database "Booking Database\nUser, Building, Room, Booking,\nBookingStatus, Equipment, RoomEquipment" as DB

  ' required — залежність споживача від контракту
  UI ..> IBookingApi
  API ..> IBookingService
  BookingSvc ..> IAvailabilityService
  BookingSvc ..> IAuthentication
  BookingSvc ..> IBookingRepository
  BookingSvc ..> IRoomRepository
  AvailSvc ..> IBookingRepository : читання blockingBookings
  AvailSvc ..> IRoomRepository : дані Room

  ' provided — реалізація контракту
  API ..|> IBookingApi
  BookingSvc ..|> IBookingService
  AvailSvc ..|> IAvailabilityService
  AuthAdapter ..|> IAuthentication
  BookingRepo ..|> IBookingRepository
  RoomRepo ..|> IRoomRepository

  ' Фізичне збереження: окремо від контрактів
  BookingRepo -down-> DB : транзакція + повторна перевірка
  RoomRepo -down-> DB : SQL / запити
}

cloud "Університетська\nавтентифікація\n(зовнішня система)" as ExtAuth
User --> UI : пошук / бронювання
AuthAdapter --> ExtAuth : validateSession(session)

note bottom of BookingRepo
  REQ-02A: createBookingAtomically(...)
  begin / lockRoom / checkBlockingBookings
  insert Pending + commit або rollback
end note

legend bottom
  ..> required — компонент використовує інтерфейс
  ..|> provided — компонент реалізує інтерфейс
  BookingService координує UC-02; BookingRepository гарантує атомарність
endlegend
@enduml
