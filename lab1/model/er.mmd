erDiagram
    %% UNIQUE(ROOM.building_id, ROOM.room_number)
    %% BOOKING.starts_at < BOOKING.ends_at
    %% ROOM_EQUIPMENT.quantity > 0
    %% Bookings for the same room must not overlap when BOOKING_STATUS.blocks_room = true

    USER ||--o{ BOOKING : creates
    BUILDING ||--|{ ROOM : contains
    ROOM ||--o{ BOOKING : reserved_for
    BOOKING_STATUS ||--o{ BOOKING : assigned_to
    ROOM ||--o{ ROOM_EQUIPMENT : has
    EQUIPMENT ||--o{ ROOM_EQUIPMENT : installed_as

    USER {
        int user_id PK
        string full_name
        string email UK
    }

    BUILDING {
        int building_id PK
        string name
        string address
    }

    ROOM {
        int room_id PK
        int building_id FK
        string room_number
        int capacity
    }

    BOOKING {
        int booking_id PK
        int user_id FK
        int room_id FK
        int status_id FK
        datetime starts_at
        datetime ends_at
        string purpose
    }

    BOOKING_STATUS {
        int status_id PK
        string name UK
        boolean blocks_room
    }

    EQUIPMENT {
        int equipment_id PK
        string name UK
    }

    ROOM_EQUIPMENT {
        int room_id PK, FK
        int equipment_id PK, FK
        int quantity
    }
